<Window x:Class="onallo0107__brawlstars.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:onallo0107__brawlstars"
        mc:Ignorable="d"
        Title="𝚋𝚛𝚊𝚠𝚕 𝚜𝚝𝚊𝚛𝚜 𝚕𝚘𝚐𝚜 ⋆｡°✩" Height="475" Width="810" MinHeight="475" MinWidth="810" FontSize="16" FontFamily="Courier New">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
            <RowDefinition Height="6*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <ListBox  Margin="5" x:Name="hianyzo" Grid.Column="0" SelectionChanged="hianyzo_SelectionChanged"/>
            <ListBox Margin="5" x:Name="ezerkupas" Grid.Column="1" SelectionChanged="ezerkupas_SelectionChanged"/>
            <ListBox  Margin="5" x:Name="droppolt" Grid.Column="2" SelectionChanged="droppolt_SelectionChanged"/>
        </Grid>



        <Label Grid.Row="0" FontSize="30" Content="⋆ kiket pusholtam eddig 1000 kupára ⋆" HorizontalAlignment="Center"  VerticalAlignment="Center"/>

        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Row="1">
            
            <StackPanel  Orientation="Horizontal">
                <Label  Margin="5" Content="már 1000 kupán van:"></Label>
                <TextBox MinWidth="200" Margin="5" x:Name="ujhozzaadas" />
                <Button x:Name="Save" Margin="5" Content="mentés" Padding="5" Click="Save_Click"/>
            </StackPanel>
            
            <StackPanel  Orientation="Horizontal">
                <Label  Margin="5" Content="droppolt karakter:"></Label>
                <TextBox MinWidth="200" Margin="5" x:Name="dropping" />
                <Button x:Name="Dropped" Margin="5" Content="droppoltam" Padding="5" Click="Dropped_Click"/>
                <Button x:Name="Remove" Margin="5" Content="torolnem" Padding="5" Click="Remove_Click"/>
            </StackPanel>
            
            <StackPanel  Orientation="Horizontal">
                <Label  Margin="5" Content="új karakter:"></Label>
                <TextBox MinWidth="200" Margin="5" x:Name="osszesupdate" />
                <Button x:Name="Update" Margin="5" Content="mentés" Padding="5" Click="Update_Click"/>
                <Label x:Name="warning" Content=""></Label>
            </StackPanel>
            
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Label Content="osszes brawler: "></Label>
                <TextBox MinWidth="35" IsEnabled="False" Text="" x:Name="stat_osszesSzama"></TextBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Label Content="- 1000 kupás: "></Label>
                <TextBox MinWidth="35" IsEnabled="False" Text="" x:Name="stat_ezerSzama"></TextBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Label Content="- droppolt: "></Label>
                <TextBox MinWidth="35" IsEnabled="False" Text="" x:Name="stat_droppoltSzama"></TextBox>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Label Content="- 550 folotti: "></Label>
                <TextBox MinWidth="35" IsEnabled="False" Text="" x:Name="stat_hatralevoSzama"></TextBox>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
